<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Petualangan Bangun Datar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fredoka+One&family=Quicksand:wght@400;700&display=swap');
        
        body {
            font-family: 'Quicksand', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow-x: hidden;
        }

        .heading-font {
            font-family: 'Fredoka One', cursive;
        }

        .card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 2rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
        }

        .btn-bounce {
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .btn-bounce:active {
            transform: scale(0.9);
        }

        .shape-container svg {
            filter: drop-shadow(3px 3px 0px rgba(0,0,0,0.1));
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade {
            animation: fadeIn 0.5s ease forwards;
        }

        .progress-bar {
            height: 12px;
            background: #e2e8f0;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: #48bb78;
            transition: width 0.4s ease;
        }
    </style>
</head>
<body>

<div id="game-container" class="w-full max-w-2xl p-4">
    <!-- Main Menu -->
    <div id="main-menu" class="card p-8 text-center animate-fade">
        <h1 class="heading-font text-4xl text-indigo-700 mb-4">📐 Petualangan Bangun Datar</h1>
        <p class="text-gray-600 mb-8">Halo Penjelajah Muda! Mari uji pengetahuanmu tentang dunia bangun datar dan jadilah masternya!</p>
        
        <div class="mb-8">
            <div class="shape-container flex justify-center gap-4 mb-4">
                <svg width="60" height="60" viewBox="0 0 100 100"><rect x="10" y="10" width="80" height="80" fill="#4299E1" rx="5"/></svg>
                <svg width="60" height="60" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="#F56565"/></svg>
                <svg width="60" height="60" viewBox="0 0 100 100"><polygon points="50,10 90,90 10,90" fill="#48BB78"/></svg>
            </div>
        </div>

        <button onclick="startGame()" class="btn-bounce bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-4 px-12 rounded-full text-xl shadow-lg">
            Mulai Petualangan
        </button>
    </div>

    <!-- Game UI -->
    <div id="game-screen" class="hidden card p-6 animate-fade">
        <div class="flex justify-between items-center mb-6">
            <div class="text-indigo-600 font-bold">
                Level <span id="level-display">1</span> / 10
            </div>
            <div class="text-orange-500 font-bold flex items-center">
                ⭐ <span id="score-display">0</span>
            </div>
        </div>

        <div class="progress-bar mb-8">
            <div id="progress-fill" class="progress-fill" style="width: 10%"></div>
        </div>

        <div id="question-area" class="text-center">
            <div id="shape-visual" class="flex justify-center mb-6">
                <!-- SVG injected by JS -->
            </div>
            <h2 id="question-text" class="text-2xl font-bold text-gray-800 mb-8 leading-tight">
                Sedang memuat tantangan...
            </h2>
            
            <div id="options-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Buttons injected by JS -->
            </div>
        </div>
    </div>

    <!-- Feedback UI -->
    <div id="feedback-overlay" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 hidden z-50">
        <div id="feedback-card" class="card p-8 text-center max-w-xs w-full animate-fade">
            <div id="feedback-icon" class="text-6xl mb-4"></div>
            <h3 id="feedback-title" class="heading-font text-2xl mb-2"></h3>
            <p id="feedback-message" class="text-gray-600 mb-6"></p>
            <button onclick="nextQuestion()" class="bg-indigo-600 text-white font-bold py-2 px-8 rounded-full w-full">
                Lanjut
            </button>
        </div>
    </div>

    <!-- Result Screen -->
    <div id="result-screen" class="hidden card p-10 text-center animate-fade">
        <div class="text-7xl mb-6">🏆</div>
        <h2 class="heading-font text-4xl text-indigo-700 mb-2">Hebat!</h2>
        <p class="text-xl text-gray-600 mb-8">Kamu telah menyelesaikan petualangan ini!</p>
        
        <div class="bg-indigo-50 rounded-2xl p-6 mb-8">
            <div class="text-sm text-indigo-400 uppercase tracking-widest font-bold">Skor Akhir Kamu</div>
            <div class="text-6xl font-bold text-indigo-700" id="final-score">0</div>
        </div>

        <button onclick="restartGame()" class="btn-bounce bg-green-500 hover:bg-green-600 text-white font-bold py-4 px-12 rounded-full text-xl shadow-lg">
            Main Lagi
        </button>
    </div>
</div>

<script>
    const questions = [
        {
            type: "visual",
            shape: "square",
            question: "Bangun datar di atas memiliki 4 sisi yang sama panjang dan 4 sudut siku-siku. Namaku adalah...",
            options: ["Persegi", "Persegi Panjang", "Belah Ketupat", "Trapesium"],
            answer: 0,
            svg: '<svg width="120" height="120" viewBox="0 0 100 100"><rect x="10" y="10" width="80" height="80" fill="#4299E1" stroke="#2B6CB0" stroke-width="4"/></svg>'
        },
        {
            type: "property",
            shape: "triangle",
            question: "Aku memiliki 3 sisi dan jumlah ketiga sudutku selalu 180 derajat. Aku adalah...",
            options: ["Lingkaran", "Segitiga", "Segi Lima", "Jajar Genjang"],
            answer: 1,
            svg: '<svg width="120" height="120" viewBox="0 0 100 100"><polygon points="50,10 90,90 10,90" fill="#48BB78" stroke="#2F855A" stroke-width="4"/></svg>'
        },
        {
            type: "visual",
            shape: "circle",
            question: "Aku hanya memiliki 1 sisi melengkung dan tidak punya titik sudut. Aku adalah...",
            options: ["Oval", "Segi Delapan", "Lingkaran", "Bola"],
            answer: 2,
            svg: '<svg width="120" height="120" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="#F56565" stroke="#C53030" stroke-width="4"/></svg>'
        },
        {
            type: "math",
            shape: "rectangle",
            question: "Sebuah persegi panjang memiliki panjang 10 cm dan lebar 5 cm. Berapa Luasnya? (L = p x l)",
            options: ["15 cm²", "30 cm²", "50 cm²", "25 cm²"],
            answer: 2,
            svg: '<svg width="160" height="100" viewBox="0 0 160 100"><rect x="10" y="20" width="140" height="60" fill="#ECC94B" stroke="#B7791F" stroke-width="4"/></svg>'
        },
        {
            type: "property",
            shape: "rhombus",
            question: "Aku punya 4 sisi sama panjang, tapi sudutku bukan siku-siku. Aku mirip layang-layang yang sempurna. Aku adalah...",
            options: ["Jajar Genjang", "Trapesium", "Belah Ketupat", "Persegi"],
            answer: 2,
            svg: '<svg width="120" height="120" viewBox="0 0 100 100"><polygon points="50,10 90,50 50,90 10,50" fill="#9F7AEA" stroke="#6B46C1" stroke-width="4"/></svg>'
        },
        {
            type: "math",
            shape: "square",
            question: "Jika sisi sebuah persegi adalah 6 cm, berapakah kelilingnya? (K = 4 x s)",
            options: ["12 cm", "24 cm", "36 cm", "18 cm"],
            answer: 1,
            svg: '<svg width="100" height="100" viewBox="0 0 100 100"><rect x="20" y="20" width="60" height="60" fill="#4299E1" stroke="#2B6CB0" stroke-width="4"/><text x="45" y="15" fill="#2B6CB0" font-weight="bold">6cm</text></svg>'
        },
        {
            type: "property",
            shape: "trapezoid",
            question: "Aku memiliki sepasang sisi sejajar tetapi tidak sama panjang. Aku adalah...",
            options: ["Trapesium", "Layang-layang", "Jajar Genjang", "Segitiga"],
            answer: 0,
            svg: '<svg width="150" height="100" viewBox="0 0 150 100"><polygon points="40,20 110,20 140,80 10,80" fill="#ED64A6" stroke="#B83280" stroke-width="4"/></svg>'
        },
        {
            type: "property",
            shape: "parallelogram",
            question: "Aku punya dua pasang sisi sejajar dan sudut yang berhadapan sama besar. Namaku...",
            options: ["Persegi Panjang", "Jajar Genjang", "Belah Ketupat", "Trapesium"],
            answer: 1,
            svg: '<svg width="150" height="100" viewBox="0 0 150 100"><polygon points="40,20 140,20 110,80 10,80" fill="#667eea" stroke="#4c51bf" stroke-width="4"/></svg>'
        },
        {
            type: "math",
            shape: "triangle_math",
            question: "Alas segitiga 8 cm dan tinggi 5 cm. Berapa Luasnya? (L = ½ x a x t)",
            options: ["40 cm²", "13 cm²", "20 cm²", "10 cm²"],
            answer: 2,
            svg: '<svg width="120" height="120" viewBox="0 0 100 100"><polygon points="20,90 80,90 80,30" fill="#48BB78" stroke="#2F855A" stroke-width="4"/><text x="45" y="98" font-size="10" fill="#2F855A">8cm</text><text x="85" y="60" font-size="10" fill="#2F855A">5cm</text></svg>'
        },
        {
            type: "property",
            shape: "kite",
            question: "Aku punya dua pasang sisi sama panjang dan diagonal yang saling tegak lurus. Aku sering diterbangkan di langit!",
            options: ["Belah Ketupat", "Trapesium", "Layang-layang", "Segitiga"],
            answer: 2,
            svg: '<svg width="120" height="120" viewBox="0 0 100 100"><polygon points="50,10 80,50 50,90 20,50" fill="#F6AD55" stroke="#C05621" stroke-width="4"/></svg>'
        }
    ];

    let currentLevel = 0;
    let score = 0;

    function startGame() {
        document.getElementById('main-menu').classList.add('hidden');
        document.getElementById('game-screen').classList.remove('hidden');
        loadQuestion();
    }

    function loadQuestion() {
        const q = questions[currentLevel];
        document.getElementById('level-display').innerText = currentLevel + 1;
        document.getElementById('score-display').innerText = score;
        document.getElementById('progress-fill').style.width = ((currentLevel + 1) / questions.length * 100) + '%';
        
        document.getElementById('shape-visual').innerHTML = q.svg;
        document.getElementById('question-text').innerText = q.question;
        
        const optionsGrid = document.getElementById('options-grid');
        optionsGrid.innerHTML = '';
        
        q.options.forEach((opt, index) => {
            const btn = document.createElement('button');
            btn.className = "btn-bounce bg-white border-2 border-indigo-100 hover:border-indigo-500 hover:bg-indigo-50 text-gray-700 font-bold py-4 px-6 rounded-2xl shadow-sm text-lg text-left transition-all flex items-center";
            btn.innerHTML = `<span class="bg-indigo-100 text-indigo-600 w-8 h-8 rounded-full inline-flex items-center justify-center mr-3 text-sm">${String.fromCharCode(65 + index)}</span> ${opt}`;
            btn.onclick = () => checkAnswer(index);
            optionsGrid.appendChild(btn);
        });
    }

    function checkAnswer(selectedIndex) {
        const q = questions[currentLevel];
        const isCorrect = selectedIndex === q.answer;
        
        const feedbackOverlay = document.getElementById('feedback-overlay');
        const feedbackIcon = document.getElementById('feedback-icon');
        const feedbackTitle = document.getElementById('feedback-title');
        const feedbackMessage = document.getElementById('feedback-message');
        
        if (isCorrect) {
            score += 10;
            feedbackIcon.innerText = "🌟";
            feedbackTitle.innerText = "Luar Biasa!";
            feedbackTitle.className = "heading-font text-2xl mb-2 text-green-500";
            feedbackMessage.innerText = "Jawabanmu tepat sekali!";
        } else {
            feedbackIcon.innerText = "💡";
            feedbackTitle.innerText = "Ups, Kurang Tepat";
            feedbackTitle.className = "heading-font text-2xl mb-2 text-orange-500";
            feedbackMessage.innerText = `Jawaban yang benar adalah: ${q.options[q.answer]}`;
        }
        
        feedbackOverlay.classList.remove('hidden');
    }

    function nextQuestion() {
        document.getElementById('feedback-overlay').classList.add('hidden');
        currentLevel++;
        
        if (currentLevel < questions.length) {
            loadQuestion();
        } else {
            showResults();
        }
    }

    function showResults() {
        document.getElementById('game-screen').classList.add('hidden');
        document.getElementById('result-screen').classList.remove('hidden');
        document.getElementById('final-score').innerText = score;
    }

    function restartGame() {
        currentLevel = 0;
        score = 0;
        document.getElementById('result-screen').classList.add('hidden');
        document.getElementById('main-menu').classList.remove('hidden');
    }
</script>

</body>
</html>
